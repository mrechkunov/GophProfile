1. добавлена папка k8s в ней все файлы для запуска в кубе
3. для деплоя использовал локальный кластер в контейнере minikube

1. brew install minikube
2. minikube start
3. brew install helm
4. minikube image build -t gophprofile-app:12.0.1 .
5. cd ./k8s/helm
6. minikube ip
7. add to /etc/hosts 
<minikube ip>	gophprofile.local
<minikube ip>	grafana.local
<minikube ip>	jaeger.local

minikube addons enable ingress

helm install gophprofile ./gophprofile




# 8. helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
# 9. helm repo update
# 10. kubectl create namespace ingress-nginx


# 11.  helm install nginx-ingress ingress-nginx/ingress-nginx --namespace ingress-nginx
6. 
